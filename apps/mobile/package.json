    "@types/node": "^26.6.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.12"
  },
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:native": "expo export --platform android --platform ios --output-dir dist/native"
